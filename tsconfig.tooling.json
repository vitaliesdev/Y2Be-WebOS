{
  // Build and tool scripts, which run on Node.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ESNext"],
    "types": ["node"],
    "checkJs": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext"
  },
  "include": [
    "./tools",
    "./assets/appinfo.json",
    "./package.json",
    "./webpack.config.js",
    "./eslint.config.ts"
  ]
}
